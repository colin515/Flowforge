{
  "name": "flowforge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @flowforge/web",
    "dev:desktop": "npm run dev -w @flowforge/desktop",
    "build": "npm run build --workspaces",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run tauri -w @flowforge/desktop --",
    "ocr:assets": "node scripts/ocr-assets.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
